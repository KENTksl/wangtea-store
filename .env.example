# ==========================================
# MAOCHA STORE - MẪU BIẾN MÔI TRƯỜNG (.env.example)
# Sao chép file này thành .env.local để cấu hình
# ==========================================

# 1. Cơ sở dữ liệu MongoDB (Tùy chọn)
# Nếu không cung cấp, hệ thống tự động sử dụng bộ dữ liệu dự phòng chuẩn
MONGODB_URI=
MONGODB_DB=maocha

# 2. Tài khoản Quản trị viên (Bắt buộc để đăng nhập /admin)
# Đổi lại email và mật khẩu an toàn của riêng bạn
ADMIN_EMAIL=admin@maocha.vn
ADMIN_PASSWORD=your_secure_password_here

# 3. Khóa bí mật ký phiên đăng nhập JWT/Cookie (Bắt buộc)
# Chuỗi ngẫu nhiên tối thiểu 32 ký tự
AUTH_SECRET=your_32_characters_random_secret_string
